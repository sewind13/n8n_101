    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Date in the sheet is dd-MM-yyyy (written by the main flow).\nconst WARN_DAYS = 5;\nconst EXPIRE_DAYS = 7;\n\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (!r || !r.Id || !r.Date) continue;\n\n  const [d, m, y] = String(r.Date).split('-').map(Number);\n  if (!d || !m || !y) continue;            // unparseable date -> leave it alone\n  const created = new Date(y, m - 1, d);\n  created.setHours(0, 0, 0, 0);\n\n  const ageDays = Math.floor((today - created) / 86400000);\n  if (ageDays < 0) continue;               // clock skew / future-dated row\n\n  let bucket = 'none';\n  if (ageDays >= EXPIRE_DAYS) bucket = 'expire';\n  else if (ageDays === WARN_DAYS) bucket = 'warn';   // exactly once, not every day after\n  if (bucket === 'none') continue;\n\n  out.push({ json: { ...r, ageDays, bucket, expireDays: EXPIRE_DAYS } });\n}\nreturn out;"
      },
