    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build the \"which claim is this slip for?\" carousel.\n// Runs once for all rows so it can see every open claim at the same time.\nconst rows = $input.all().map(i => i.json).filter(r => r && r.Id);\nconst drive = $('Upload Slip to Drive').first().json;\nconst fileId = drive.id;\nconst slipUrl = drive.webViewLink || `https://drive.google.com/file/d/${fileId}/view`;\nconst replyToken = $('Webhook').first().json.body.events[0].replyToken;\n\nconst clip = (s, n) => {\n  const t = String(s ?? '').replace(/\\s+/g, ' ').trim() || '-';\n  return t.length > n ? t.slice(0, n - 1) + '…' : t;\n};\n\nlet messages;\n\nif (rows.length === 0) {\n  messages = [{\n    type: 'text',\n    text: 'รับสลิปแล้ว แต่ยังไม่มีใบเบิกที่รอหลักฐานอยู่\\n' +\n          'พิมพ์รายการและจำนวนเงินเข้ามาก่อน แล้วส่งสลิปซ้ำอีกครั้งนะครับ\\n\\n' +\n          'สลิปที่เพิ่งส่ง: ' + slipUrl,\n  }];\n} else {\n  // newest first; carousel caps at 10 columns and we reserve one for \"none of these\"\n  const sorted = rows.slice().reverse();\n  const shown = sorted.slice(0, 9);\n\n  const columns = shown.map(r => ({\n    title: clip(r.Id, 40),\n    text: clip(`${r.Description} · ${r.Amount} บาท · ${r.Date}`, 60),\n    actions: [{\n      type: 'postback',\n      label: 'แนบสลิปใบนี้',\n      // everything the confirm branch needs travels in the postback itself\n      data: `action=attach&id=${encodeURIComponent(r.Id)}&file=${encodeURIComponent(fileId)}`,\n      displayText: `แนบสลิปกับ ${r.Id}`,\n    }],\n  }));\n\n  columns.push({\n    title: 'ไม่ใช่ทั้งหมด',\n    text: sorted.length > 9\n      ? `ยังมีใบค้างอีก ${sorted.length - 9} ใบ หรือเปิดใบใหม่`\n      : 'เปิดใบเบิกใหม่สำหรับสลิปนี้',\n    actions: [{\n      type: 'postback',\n      label: 'เปิดใบใหม่',\n      data: `action=new&file=${encodeURIComponent(fileId)}`,\n      displayText: 'เปิดใบเบิกใหม่',\n    }],\n  });\n\n  messages = [{\n    type: 'template',\n    altText: 'สลิปนี้เป็นของใบเบิกไหน?',\n    template: { type: 'carousel', columns },\n  }];\n}\n\nreturn [{ json: { replyToken, messages } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
